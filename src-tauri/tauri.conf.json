{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChannelCraft Studio",
  "version": "0.2.6",
  "identifier": "com.channelcraft.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ChannelCraft Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/starter-theme/": "starter-theme/",
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../LICENSE": "LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ChannelCraft Studio",
    "copyright": "ChannelCraft Studio contributors",
    "category": "Utility",
    "shortDescription": "Theme editor for RetroBat",
    "longDescription": "Edit and create RetroBat (EmulationStation) themes with a live preview. Saves are backed up first and can be restored.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNjFERUZCRTNCRjAwOTcKUldTWEFML2orOTVoUVFHWlc2eTkrbVRab1QvU3VxN1h3UWNpSzc0QjVrUkNhaitWYVAyQVpYcUcK",
      "endpoints": [
        "https://github.com/Booga12/Channelcraft-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
